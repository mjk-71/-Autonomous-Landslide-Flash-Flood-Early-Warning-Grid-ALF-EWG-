# ====================================================================
# .gitignore for C++ Project (ALF-EWG)
# ====================================================================

# Compiled Object files & Executables
*.exe
*.out
*.app
*.o
*.obj

# Dynamic Libraries
*.dll
*.so
*.dylib

# Debug Symbols & Profiling
*.pdb
*.ilk
*.dSYM/

# Runtime Data & Persistence Files (generated during execution)
*.bin
incidents.bin
*.log

# IDE & Editor Configurations
.vscode/
.idea/
*.suo
*.user
*.userosv
*.sln.docstates
.vs/

# Python Virtual Environments & Bytecode (report generator)
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
ENV/

# Operating System Temporary Files
Thumbs.db
Desktop.ini
.DS_Store
.directory
